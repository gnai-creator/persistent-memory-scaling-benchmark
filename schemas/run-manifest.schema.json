{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aletheion.ai/schemas/pmsb/tg-run-manifest-v1.json",
  "title": "PMSB TrustGraph run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "phase", "status", "seed", "event_count", "query_count", "workspace", "collection", "flow_id", "upstream", "deployment", "models", "hardware", "artifacts"],
  "properties": {
    "schema_version": {"const": "tg-run-manifest-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "phase": {"const": "TG-0"},
    "status": {"enum": ["planned", "running", "completed", "failed"]},
    "seed": {"type": "integer", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 0},
    "query_count": {"type": "integer", "minimum": 0},
    "workspace": {"type": "string", "minLength": 1},
    "collection": {"type": "string", "minLength": 1},
    "flow_id": {"type": "string", "minLength": 1},
    "upstream": {"type": "object"},
    "deployment": {"type": "object"},
    "models": {"type": "object"},
    "hardware": {"type": "object"},
    "artifacts": {"type": "object"}
  }
}
